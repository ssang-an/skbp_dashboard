{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skbp.local/schemas/dashboard-hybrid-record.schema.json",
  "title": "SKBP Dashboard Hybrid Persisted Record",
  "description": "Dashboard columns, chart/filter values, scores, compact display evidence, graph projections, preserved GPT Markdown, and dashboard-owned operational state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "source_report",
    "input",
    "json_summary",
    "structured_table",
    "hard_filter",
    "scoring",
    "validation",
    "final_insight"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["storage_profile", "review_type", "generated_at", "output_filename_base"],
      "properties": {
        "storage_profile": { "const": "dashboard_hybrid_v1" },
        "review_type": { "enum": ["fast_triage", "full_scout"] },
        "generated_at": { "type": "string" },
        "dashboard_uploaded_at": { "type": "string" },
        "output_filename_base": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string" },
        "instruction_version": { "type": "string" },
        "rubric_version": { "type": "string" },
        "pipeline_metadata": {
          "type": "object",
          "description": "Dashboard-owned internal Listing metadata. It must not affect GPT research, rubric scoring, or source-report content.",
          "properties": {
            "listed_at": { "type": "string" },
            "comment": { "type": "string", "maxLength": 5000 },
            "contact": { "type": "string", "maxLength": 5000 },
            "updated_at": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "source_report": {
      "type": "object",
      "required": ["raw_markdown", "parser_status"],
      "properties": {
        "raw_markdown": { "type": "string" },
        "parser_status": { "type": "string" },
        "revision_history": { "type": "array" },
        "rubric_recalculation": { "type": "object" },
        "llm_reparse_fields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["company_input", "asset_input"],
      "properties": {
        "company_input": { "type": "string", "minLength": 1 },
        "asset_input": { "type": "string", "minLength": 1 },
        "user_context": {
          "type": "string",
          "maxLength": 6000,
          "description": "Optional user-provided meeting note or research context. It is not a verified public source."
        }
      },
      "additionalProperties": false
    },
    "json_summary": {
      "type": "object",
      "required": ["theme", "cluster", "target_description"],
      "properties": {
        "theme": { "enum": ["E/I Balance", "Neuroimmune", "Protein Homeostasis", "Others", "Unknown", "N/A", "No Theme"] },
        "cluster": { "type": "string", "minLength": 1 },
        "target_description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "structured_table": { "$ref": "#/$defs/structuredTable" },
    "hard_filter": { "$ref": "#/$defs/hardFilter" },
    "scoring": { "$ref": "#/$defs/scoring" },
    "validation": {
      "type": "object",
      "required": ["uncertain_points", "cross_checked_facts", "source_registry"],
      "properties": {
        "uncertain_points": { "type": "array", "items": { "type": "string" } },
        "cross_checked_facts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["fact", "sources"],
                "properties": {
                  "fact": { "type": "string" },
                  "sources": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "source_registry": { "type": "array", "items": { "$ref": "#/$defs/evidenceSource" } }
      },
      "additionalProperties": false
    },
    "final_insight": {
      "type": "object",
      "required": ["one_line_summary", "recommendation", "most_important_diligence_question"],
      "properties": {
        "one_line_summary": { "type": "string" },
        "recommendation": { "type": "string" },
        "most_important_diligence_question": { "type": "string" }
      },
      "additionalProperties": false
    },
    "triage": { "$ref": "#/$defs/triage" },
    "company_profile": { "$ref": "#/$defs/companyProfile" },
    "competitive_analysis": { "$ref": "#/$defs/competitiveAnalysis" },
    "ai_revision_draft": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "meta": { "properties": { "review_type": { "const": "fast_triage" } } } }
      },
      "then": {
        "required": ["triage"],
        "properties": {
          "hard_filter": { "properties": { "status": { "enum": ["SELECT", "REJECT", "UNVERIFIED"] } } },
          "scoring": {
            "properties": {
              "max_score": { "type": ["integer", "null"] },
              "criteria": {
                "required": ["target_relevance", "moa_validity", "data_maturity"],
                "properties": {
                  "competitive_landscape": false,
                  "platform_attractiveness": false,
                  "expansion_potential": false,
                  "marketability": false
                }
              }
            }
          }
        }
      },
      "else": {
        "required": ["company_profile", "competitive_analysis"],
        "properties": {
          "hard_filter": { "properties": { "status": { "enum": ["PASS", "REVIEW", "FAIL"] } } },
          "scoring": {
            "properties": {
              "max_score": { "const": 21 },
              "criteria": {
                "required": [
                  "target_relevance",
                  "competitive_landscape",
                  "moa_validity",
                  "platform_attractiveness",
                  "expansion_potential",
                  "data_maturity",
                  "marketability"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "scoreCriterion": {
      "type": "object",
      "required": [
        "score",
        "evidence_type",
        "evidence_type_reason",
        "evidence_basis",
        "main_line_summary",
        "why_not_higher",
        "investigation_note",
        "uncertain_points",
        "source_ids"
      ],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 3 },
        "evidence_type": { "type": "string" },
        "evidence_type_reason": { "type": "string" },
        "evidence_basis": { "type": "string" },
        "main_line_summary": { "type": "string" },
        "why_not_higher": { "type": "string" },
        "investigation_note": { "type": "string" },
        "uncertain_points": { "type": "array", "items": { "type": "string" } },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "calculation": { "$ref": "#/$defs/marketabilityDisplayCalculation" }
      },
      "additionalProperties": false
    },
    "evidenceSource": {
      "type": "object",
      "required": ["source_id", "source_title", "source_url"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_title": { "type": "string" },
        "source_url": { "type": "string" },
        "source_type": { "type": "string" },
        "reliability": { "type": "string" },
        "evidence_summary": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "marketabilityDisplayCalculation": {
      "type": "object",
      "required": [
        "commercial_rationale_status",
        "commercial_rationale_failure_reason",
        "A_targetable_addressable_patient",
        "B_unrisked_peak_sales",
        "C_obtainable_peak_sales"
      ],
      "properties": {
        "commercial_rationale_status": { "type": "string" },
        "commercial_rationale_failure_reason": { "type": "string" },
        "A_targetable_addressable_patient": {
          "type": "object",
          "required": ["targetable_addressable_patient", "formula"],
          "properties": {
            "targetable_addressable_patient": { "type": ["number", "null"] },
            "formula": { "type": "string" }
          },
          "additionalProperties": false
        },
        "B_unrisked_peak_sales": {
          "type": "object",
          "required": ["unrisked_peak_sales", "sales_unit", "formula"],
          "properties": {
            "unrisked_peak_sales": { "type": ["number", "null"] },
            "sales_unit": { "type": "string" },
            "formula": { "type": "string" }
          },
          "additionalProperties": false
        },
        "C_obtainable_peak_sales": {
          "type": "object",
          "required": ["obtainable_peak_sales", "sales_unit", "formula"],
          "properties": {
            "obtainable_peak_sales": { "type": ["number", "null"] },
            "sales_unit": { "type": "string" },
            "formula": { "type": "string" }
          },
          "additionalProperties": false
        },
        "D_global_obtainable_peak_sales": {
          "type": "object",
          "required": [
            "source_geography",
            "global_multiplier",
            "global_obtainable_peak_sales",
            "sales_unit",
            "formula"
          ],
          "properties": {
            "source_geography": { "const": "US" },
            "global_multiplier": { "const": 1.5 },
            "global_obtainable_peak_sales": { "type": ["number", "null"] },
            "sales_unit": { "const": "million USD" },
            "formula": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "structuredTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company",
        "asset_name",
        "target",
        "moa",
        "modality_platform",
        "main_indication",
        "indication",
        "development_stage",
        "company_country",
        "sources"
      ],
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "asset_name": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "moa": { "type": "string", "minLength": 1 },
        "modality_platform": { "type": "string", "minLength": 1 },
        "main_indication": { "type": "string" },
        "indication": { "type": "string", "minLength": 1 },
        "indication_list": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "development_stage": {
          "type": "string",
          "minLength": 1,
          "description": "Compact v2 input uses a canonical value. Migrated historical records may retain their prior display text so migration does not silently alter a dashboard cell.",
          "examples": [
            "Hit Discovery",
            "Lead Optimization",
            "Preclinical Candidate",
            "IND-enabling",
            "Preclinical unspecified",
            "IND filed/cleared",
            "Phase 1",
            "Phase 1/2",
            "Phase 2",
            "Phase 2/3",
            "Phase 3",
            "Registration",
            "Approved / marketed",
            "Discontinued / inactive",
            "Unknown"
          ]
        },
        "company_country": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["source_title", "source_url"],
            "properties": {
              "source_title": { "type": "string" },
              "source_url": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "hardFilter": {
      "type": "object",
      "required": ["status", "reason", "flags", "hard_blocker", "decision_uncertainty"],
      "properties": {
        "status": { "type": "string" },
        "reason": { "type": "string" },
        "flags": { "type": "array", "items": { "type": "string" } },
        "hard_blocker": { "type": "boolean" },
        "decision_uncertainty": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": ["criteria", "total_score", "max_score"],
      "properties": {
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_relevance": { "$ref": "#/$defs/scoreCriterion" },
            "competitive_landscape": { "$ref": "#/$defs/scoreCriterion" },
            "moa_validity": { "$ref": "#/$defs/scoreCriterion" },
            "platform_attractiveness": { "$ref": "#/$defs/scoreCriterion" },
            "expansion_potential": { "$ref": "#/$defs/scoreCriterion" },
            "data_maturity": { "$ref": "#/$defs/scoreCriterion" },
            "marketability": { "$ref": "#/$defs/scoreCriterion" }
          }
        },
        "total_score": { "type": ["integer", "null"] },
        "max_score": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "triage": {
      "type": "object",
      "required": [
        "status",
        "identity_verified",
        "active_asset",
        "verified_public_source_count",
        "why",
        "missing_evidence_needed_for_full_scout"
      ],
      "properties": {
        "status": { "enum": ["SELECT", "REJECT", "UNVERIFIED"] },
        "identity_verified": { "type": "boolean" },
        "active_asset": { "type": ["boolean", "null"] },
        "verified_public_source_count": { "type": "integer", "minimum": 0 },
        "why": { "type": "string" },
        "missing_evidence_needed_for_full_scout": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "companyProfile": {
      "type": "object",
      "required": ["headquarters", "company_stage", "platform_summary"],
      "properties": {
        "headquarters": { "type": "string" },
        "company_stage": { "type": "string" },
        "platform_summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "competitiveAnalysis": {
      "type": "object",
      "required": ["competitive_density", "similarity_summary", "competitor_table", "similar_pipelines"],
      "properties": {
        "competitive_density": { "type": "string" },
        "competitor_table": {
          "type": "array",
          "items": { "$ref": "#/$defs/competitorRow" }
        },
        "similar_pipelines": {
          "type": "array",
          "items": { "$ref": "#/$defs/similarPipelineRow" }
        },
        "similarity_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "similar_pipeline_count",
            "high_similarity_count",
            "medium_similarity_count",
            "low_similarity_count"
          ],
          "properties": {
            "similar_pipeline_count": { "type": "integer", "minimum": 0 },
            "high_similarity_count": { "type": "integer", "minimum": 0 },
            "medium_similarity_count": { "type": "integer", "minimum": 0 },
            "low_similarity_count": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "additionalProperties": false
    },
    "competitorRow": {
      "type": "object",
      "required": [
        "competitor_asset",
        "company",
        "modality",
        "target_or_moa",
        "stage",
        "similarity_level",
        "why_it_matters",
        "source_url"
      ],
      "properties": {
        "competitor_asset": { "type": "string" },
        "company": { "type": "string" },
        "modality": { "type": "string" },
        "target_or_moa": { "type": "string" },
        "stage": { "type": "string" },
        "similarity_level": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "source_url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "similarPipelineRow": {
      "type": "object",
      "required": ["company", "asset_name", "similarity_score", "matched_dimensions", "shared_data_points"],
      "properties": {
        "company": { "type": "string" },
        "asset_name": { "type": "string" },
        "similarity_score": { "type": ["number", "string", "null"] },
        "matched_dimensions": { "type": "array", "items": { "type": "string" } },
        "shared_data_points": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
