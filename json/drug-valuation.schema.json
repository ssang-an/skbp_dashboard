{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skbp.local/schemas/pipeline-shortlist-analysis.schema.json",
  "title": "SKBP PreC Pipeline Shortlist Analysis",
  "type": "object",
  "required": [
    "meta",
    "input",
    "source_report",
    "company_profile",
    "json_summary",
    "structured_table",
    "hard_filter",
    "scoring",
    "competitive_analysis",
    "validation",
    "final_insight",
    "obsidian"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "rubric": {
      "$ref": "#/$defs/rubric"
    },
    "json_summary": {
      "$ref": "#/$defs/json_summary"
    },
    "structured_table": {
      "$ref": "#/$defs/structured_table"
    },
    "hard_filter": {
      "$ref": "#/$defs/hard_filter"
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    },
    "competitive_analysis": {
      "$ref": "#/$defs/competitive_analysis"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "final_insight": {
      "$ref": "#/$defs/final_insight"
    },
    "obsidian": {
      "$ref": "#/$defs/obsidian"
    },
    "source_report": {
      "$ref": "#/$defs/source_report"
    },
    "company_profile": {
      "$ref": "#/$defs/company_profile"
    }
  },
  "$defs": {
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "language",
        "analyst_role",
        "output_format",
        "output_filename_base",
        "rubric_version",
        "rubric_author"
      ],
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "3.0"
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date the underlying GPT report/search was produced. Defaults to today (UTC) on save if missing."
        },
        "language": {
          "type": "string",
          "enum": [
            "ko",
            "en"
          ]
        },
        "analyst_role": {
          "type": "string"
        },
        "output_format": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "json",
              "markdown"
            ]
          },
          "minItems": 1
        },
        "output_filename_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "rubric_version": {
          "type": "string",
          "description": "Rubric/guideline version used to score this record (full-scout or fast-triage rubric depending on workflow)."
        },
        "rubric_author": {
          "type": "string",
          "default": "kate"
        },
        "last_edited_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 UTC timestamp of the most recent human/dashboard edit to this record."
        },
        "last_edited_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identifier of who made the most recent edit. Temporary stand-in until SSO login is wired up: stores the requester's IP address."
        },
        "edit_history": {
          "type": "array",
          "description": "Append-only log of human/dashboard edits, newest last. Each entry stamps when and by whom (IP, pending SSO) a change was made.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "changed_at",
              "actor_ip",
              "source"
            ],
            "properties": {
              "changed_at": {
                "type": "string",
                "description": "ISO 8601 UTC timestamp."
              },
              "actor_ip": {
                "type": "string",
                "description": "Requester IP address, temporary stand-in for user identity until SSO is available."
              },
              "actor_name": {
                "type": "string",
                "description": "Reviewer-entered name or employee ID. Preferred for the visible audit trail when present; actor_ip remains as a technical fallback."
              },
              "source": {
                "type": "string",
                "description": "Which UI/endpoint made the change, e.g. detail_json_editor, dashboard_table_manual_review, dashboard_tab3_focus_management, dashboard_comment, dashboard_attachment_upload, dashboard_attachment_delete, dashboard_qualitative_review, paste_json_upsert."
              },
              "field": {
                "type": "string"
              },
              "previous_value": {},
              "new_value": {}
            }
          }
        },
        "human_review": {
          "type": "object",
          "description": "Manual score/status overrides layered on top of AI baseline values. overrides.status_reason stores the editable one-line human rationale shown beside Review status; both status and rationale changes are audit-logged.",
          "additionalProperties": true
        },
        "focus_management": {
          "type": "object",
          "description": "TAB3/full-scout review workspace state. OI Partnership v1.0 stores an auto-classified or human-overridden partnership_type (investment|value_up|joint_research|n_a|unknown), partnership_note, evidence sources, source/status, and the auto suggestion. Also supports partner material flags and the in_vivo_status/in_vitro_status/admet_completed evidence-summary triple.",
          "additionalProperties": true,
          "properties": {
            "partnership_type": {
              "type": "string",
              "enum": ["", "investment", "value_up", "joint_research", "n_a", "unknown"],
              "description": "Final Filter 3 value. Automatic rules use target indication, modality, stage, in-vivo/in-vitro outcome, ADMET score, and Platform Attractiveness. A human selection takes precedence until Auto is selected again. Empty is accepted only for legacy/untracked records before classification."
            },
            "partnership_note": {
              "type": "string",
              "description": "Applied rule, overlap, missing-field list, or N/A reason shown immediately to the right of Filter 3."
            },
            "partnership_evidence_sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tab3 structured data, Tab2 report, and uploaded filenames used for the final classification."
            },
            "partnership_classification_source": {
              "type": "string",
              "enum": ["auto", "manual", "unclassified"]
            },
            "partnership_classification_status": {
              "type": "string",
              "enum": ["auto_classified", "manual_override", "pending_criteria"]
            },
            "partnership_classification_criteria_version": {
              "type": "string"
            },
            "partnership_auto_suggestion": {
              "type": "string",
              "enum": ["investment", "value_up", "joint_research", "n_a", "unknown"],
              "description": "Latest v1.0 automatic suggestion retained even when the final partnership_type is manually overridden."
            },
            "partnership_auto_note": {
              "type": "string"
            },
            "partnership_auto_evidence_sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "partner_material_flags": {
              "type": "object",
              "description": "Human-maintained availability indicators for CDP, NCDP, and ADMET partner materials. The detail UI also derives effective active states only from standalone CDP, NCDP, or ADMET tokens in uploaded attachment filenames; an automatic match does not overwrite these manual booleans.",
              "additionalProperties": false,
              "properties": {
                "cdp": {
                  "type": "boolean"
                },
                "ncdp": {
                  "type": "boolean"
                },
                "admet": {
                  "type": "boolean"
                }
              }
            },
            "partner_material_flag_overrides": {
              "type": "object",
              "description": "Explicit human overrides for CDP, NCDP, and ADMET availability. When a boolean exists for a key, it takes precedence over filename auto-detection so a user can manually switch the indicator on or off.",
              "additionalProperties": false,
              "properties": {
                "cdp": {
                  "type": "boolean"
                },
                "ncdp": {
                  "type": "boolean"
                },
                "admet": {
                  "type": "boolean"
                }
              }
            },
            "in_vivo_status": {
              "type": "string",
              "enum": ["O", "X", "N/A"],
              "description": "Whether an explicit in-vivo outcome was found in the GPT report + uploaded attachments. O requires positive efficacy/activity wording, X requires negative/failure wording, and N/A means absent or outcome unclear. A mere statement that an experiment was performed is not O."
            },
            "in_vivo_status_source": {
              "type": "string",
              "enum": ["auto", "manual"],
              "description": "Whether in_vivo_status was last set by the keyword heuristic (main.py's classify_evidence_presence) or overridden by a reviewer in the TAB3 table."
            },
            "in_vitro_status": {
              "type": "string",
              "enum": ["O", "X", "N/A"],
              "description": "Same detection as in_vivo_status, for in-vitro efficacy evidence."
            },
            "in_vitro_status_source": {
              "type": "string",
              "enum": ["auto", "manual"]
            },
            "admet_completed": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 50,
              "description": "Count of 'Completed' occurrences found in attachments whose filename contains 'admet', out of a fixed denominator of 50 (main.py's count_admet_completed). Null when no admet-named attachment has been uploaded yet."
            },
            "admet_completed_source": {
              "type": "string",
              "enum": ["auto", "manual"]
            }
          }
        },
        "collaboration": {
          "type": "object",
          "description": "Threaded reviewer comments attached to this record.",
          "additionalProperties": true
        },
        "attachments": {
          "type": "array",
          "description": "Original source files (PPT/PPTX/PDF/TXT/Word/Excel) uploaded from the detail page's partner-material dropzone. Each item: {id, filename, stored_path, content_type, size_bytes, uploaded_by, uploaded_at}.",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "qualitative_review": {
          "type": "object",
          "description": "Researcher opinions keyed by qualitative-review criterion id (see config/qualitative_review_criteria.md), each with an entries array of {id, author, body, is_ai, created_at}. A placeholder AI entry is auto-appended after each human entry.",
          "additionalProperties": true
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "company_input",
        "asset_input",
        "source_text",
        "source_type",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "company_input": {
          "$ref": "#/$defs/nullable_string"
        },
        "asset_input": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_text": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_type": {
          "$ref": "#/$defs/nullable_string"
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "rubric": {
      "type": "object",
      "description": "기준 설명 전용 섹션. scoring의 main_line_summary에는 이 기준 문구를 반복하지 않는다.",
      "required": [
        "target_relevance",
        "competitive_landscape",
        "moa_validity",
        "platform_attractiveness",
        "expansion_potential",
        "data_maturity",
        "marketability"
      ],
      "additionalProperties": false,
      "properties": {
        "target_relevance": {
          "$ref": "#/$defs/rubric_criterion"
        },
        "competitive_landscape": {
          "$ref": "#/$defs/rubric_criterion"
        },
        "moa_validity": {
          "$ref": "#/$defs/rubric_criterion"
        },
        "platform_attractiveness": {
          "$ref": "#/$defs/rubric_criterion"
        },
        "expansion_potential": {
          "$ref": "#/$defs/rubric_criterion"
        },
        "data_maturity": {
          "$ref": "#/$defs/rubric_criterion"
        },
        "marketability": {
          "$ref": "#/$defs/rubric_criterion"
        }
      }
    },
    "rubric_criterion": {
      "type": "object",
      "required": [
        "description",
        "score_definitions"
      ],
      "additionalProperties": true,
      "properties": {
        "description": {
          "type": "string"
        },
        "score_definitions": {
          "type": "object",
          "required": [
            "0",
            "1",
            "2",
            "3"
          ],
          "additionalProperties": false,
          "properties": {
            "0": {
              "type": "string"
            },
            "1": {
              "type": "string"
            },
            "2": {
              "type": "string"
            },
            "3": {
              "type": "string"
            }
          }
        }
      }
    },
    "json_summary": {
      "type": "object",
      "required": [
        "company",
        "company_country",
        "asset_name",
        "target",
        "theme",
        "cluster",
        "target_relevance_score",
        "one_line_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "company": {
          "$ref": "#/$defs/nullable_string"
        },
        "company_country": {
          "$ref": "#/$defs/nullable_string"
        },
        "asset_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "target": {
          "$ref": "#/$defs/nullable_string"
        },
        "theme": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "E/I Balance",
            "Neuroimmune",
            "No Theme",
            null
          ]
        },
        "cluster": {
          "$ref": "#/$defs/nullable_string"
        },
        "target_relevance_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "one_line_summary": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "structured_table": {
      "type": "object",
      "required": [
        "company",
        "company_country",
        "asset_name",
        "target",
        "theme",
        "cluster",
        "target_mapping_rationale",
        "moa",
        "modality_platform",
        "indication",
        "development_stage",
        "key_data",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "company": {
          "$ref": "#/$defs/nullable_string"
        },
        "company_country": {
          "$ref": "#/$defs/nullable_string"
        },
        "asset_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "target": {
          "$ref": "#/$defs/nullable_string"
        },
        "theme": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "E/I Balance",
            "Neuroimmune",
            "No Theme",
            null
          ]
        },
        "cluster": {
          "$ref": "#/$defs/nullable_string"
        },
        "target_mapping_rationale": {
          "$ref": "#/$defs/nullable_string"
        },
        "moa": {
          "$ref": "#/$defs/nullable_string"
        },
        "modality_platform": {
          "$ref": "#/$defs/nullable_string"
        },
        "indication": {
          "$ref": "#/$defs/nullable_string"
        },
        "development_stage": {
          "$ref": "#/$defs/nullable_string"
        },
        "key_data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key_data_item"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basic_source"
          }
        }
      }
    },
    "key_data_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_type",
        "summary",
        "details"
      ],
      "properties": {
        "data_type": {
          "$ref": "#/$defs/nullable_string"
        },
        "summary": {
          "$ref": "#/$defs/nullable_string"
        },
        "details": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "basic_source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_id",
        "source_title",
        "source_url",
        "source_excerpt"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_title": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_url": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_excerpt": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "hard_filter": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "flags"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "REVIEW",
            "FAIL",
            "Unclear"
          ],
          "description": "PASS if Total >= 14, Target Relevance >= 3, MoA Validity >= 2, Data Maturity >= 2, and no hard blocker. REVIEW if Total 9-13, or score is high but stage/rights/asset identity/source uncertainty exists. FAIL if Total <= 8, Target Relevance <= 1, or no SKBP Theme/Cluster fit."
        },
        "reason": {
          "type": "string"
        },
        "flags": {
          "$ref": "#/$defs/string_array"
        },
        "within_target_ta": {
          "$ref": "#/$defs/filter_answer"
        },
        "relevant_biological_target": {
          "$ref": "#/$defs/filter_answer"
        },
        "stage_preclinical_to_ind": {
          "$ref": "#/$defs/filter_answer"
        },
        "overall_result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW",
            "Unclear"
          ]
        },
        "fail_reasons": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "filter_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "reason"
      ],
      "properties": {
        "answer": {
          "type": "string",
          "enum": [
            "Yes",
            "No",
            "Unclear",
            "Unknown"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total_score",
        "max_score",
        "criteria"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_scored",
            "scored",
            "partial",
            "needs_review"
          ]
        },
        "total_score": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 21
        },
        "max_score": {
          "type": "integer",
          "const": 21
        },
        "criteria": {
          "$ref": "#/$defs/scoring_criteria"
        }
      }
    },
    "scoring_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_relevance",
        "competitive_landscape",
        "moa_validity",
        "platform_attractiveness",
        "expansion_potential",
        "data_maturity",
        "marketability"
      ],
      "properties": {
        "target_relevance": {
          "$ref": "#/$defs/scoring_criterion"
        },
        "competitive_landscape": {
          "$ref": "#/$defs/scoring_criterion"
        },
        "moa_validity": {
          "$ref": "#/$defs/scoring_criterion"
        },
        "platform_attractiveness": {
          "$ref": "#/$defs/scoring_criterion"
        },
        "expansion_potential": {
          "$ref": "#/$defs/scoring_criterion"
        },
        "data_maturity": {
          "$ref": "#/$defs/scoring_criterion"
        },
        "marketability": {
          "$ref": "#/$defs/marketability_criterion"
        }
      }
    },
    "scoring_criterion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "score",
        "evidence_type",
        "main_line_summary",
        "why_not_higher",
        "uncertain_points"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "evidence_type": {
          "$ref": "#/$defs/evidence_type"
        },
        "evidence_type_reason": {
          "$ref": "#/$defs/nullable_string"
        },
        "main_line_summary": {
          "$ref": "#/$defs/nullable_string"
        },
        "reason": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_ids": {
          "$ref": "#/$defs/string_array"
        },
        "what_was_checked": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_trail": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        },
        "investigation_note": {
          "$ref": "#/$defs/nullable_string"
        },
        "why_not_higher": {
          "$ref": "#/$defs/nullable_string"
        },
        "uncertain_points": {
          "$ref": "#/$defs/string_array"
        },
        "same_target_same_moa_front_runner_count": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "broader_same_disease_competitor_count": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "fic_bic_late_follower_classification": {
          "$ref": "#/$defs/nullable_string"
        },
        "competitor_table": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "proposed_moa": {
          "$ref": "#/$defs/nullable_string"
        },
        "functional_readout": {
          "$ref": "#/$defs/nullable_string"
        },
        "target_engagement_to_disease_phenotype_linkage": {
          "$ref": "#/$defs/nullable_string"
        },
        "modality_platform_identity": {
          "$ref": "#/$defs/nullable_string"
        },
        "claimed_or_inferred_differentiation": {
          "$ref": "#/$defs/nullable_string"
        },
        "differentiation_support": {
          "$ref": "#/$defs/nullable_string"
        },
        "claimed_development_stage": {
          "$ref": "#/$defs/nullable_string"
        },
        "expected_data_for_stage": {
          "$ref": "#/$defs/string_array"
        },
        "visible_asset_specific_data": {
          "$ref": "#/$defs/string_array"
        },
        "missing_data": {
          "$ref": "#/$defs/string_array"
        },
        "stage_data_alignment_judgment": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "marketability_criterion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "score",
        "evidence_type",
        "main_line_summary",
        "calculation",
        "why_not_higher",
        "uncertain_points"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "evidence_type": {
          "$ref": "#/$defs/evidence_type"
        },
        "evidence_type_reason": {
          "$ref": "#/$defs/nullable_string"
        },
