OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=1600
# AI 2차 파싱은 결정적 JSON 복구 실패 시에만 DeepSeek V4 Flash를 사용합니다.
# 8,000은 목표 길이가 아니라 첫 응답의 최대 출력 ceiling이며, 불완전 응답에서만 16,000으로 한 번 재시도합니다.
OPENROUTER_REPARSE_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_REPARSE_MAX_TOKENS=8000
OPENROUTER_REPARSE_RETRY_MAX_TOKENS=16000
# 다른 모델 fallback은 기본 비활성입니다. 명시적으로 필요할 때만 설정하세요.
# OPENROUTER_REPARSE_FALLBACK_MODELS=known-good-model-id
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_TITLE=SKBP Pipeline Finder
ENABLE_PDF_PARSER_FALLBACK=true
PDF_PARSER_ENGINE=cloudflare-ai
PDF_TEXT_MIN_CHARACTERS=50
ENABLE_PAID_OCR=false

# Self-service password reset email (SMTP relay)
# The dashboard emails a freshly generated password directly; it only displays a
# sent confirmation after the relay accepts the message.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=SKBP Pipeline Finder
SMTP_STARTTLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_RESEND_SECONDS=60

# Shortlisting Action Date reminders (Korea Standard Time, daily at 09:00)
ACTION_DATE_REMINDERS_ENABLED=true
ACTION_DATE_REMINDER_DAYS=0
